rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Products Collection (Public can read, only admin can write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if request.auth != null; // Any logged-in user can create an order
      allow update, delete: if isAdmin(); // Only admin can update order status or delete
    }

    // Contact Messages Collection
    match /contact-messages/{messageId} {
      // Admin can read all messages
      allow read: if isAdmin();
      // Logged-in users can read only their own messages
      allow read: if request.auth != null && isOwner(resource.data.sentByUid);
      // Only logged-in users can create messages (sentByUid must match their uid)
      allow create: if request.auth != null && request.resource.data.sentByUid == request.auth.uid;
      // Nobody can update or delete
      allow update, delete: if false;
    }
  }
}
